<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF8FF"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify Mobile"
        android:textColor="#183B63"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOtpHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="OTP will be sent to your number."
        android:textColor="#6D88A8" />

    <EditText
        android:id="@+id/etOtp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_medibee"
        android:hint="Enter OTP"
        android:inputType="number"
        android:maxLength="6"
        android:paddingHorizontal="14dp" />

    <Button
        android:id="@+id/btnVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#F7C531"
        android:text="Verify OTP"
        android:textColor="#1F2D3D"
        android:textStyle="bold" />
</LinearLayout>
