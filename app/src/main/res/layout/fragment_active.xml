<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    tools:context=".ActiveFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvActiveOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp"
        tools:listitem="@layout/item_active_order" />

    <ProgressBar
        android:id="@+id/activeLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tvEmptyActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="24dp"
        android:text="No active deliveries\nAccept an order from New, then track it here."
        android:textColor="@color/medibee_muted"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
