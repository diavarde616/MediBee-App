<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="App.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/medibee_navy</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">@color/medibee_category_bg</item>
        <item name="tabSelectedTextColor">@color/medibee_navy</item>
        <item name="tabTextColor">@color/medibee_muted</item>
    </style>

</resources>
